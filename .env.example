# efelle Privacy Scan — environment configuration
# Copy to .env and fill in. The app runs without a key (deterministic template
# narrative); set the key to enable Claude-generated client-facing prose.

# Anthropic API key — enables AI-generated narrative sections.
ANTHROPIC_API_KEY=

# Optional: override the model used for narrative generation.
# PRIVACY_SCAN_MODEL=claude-opus-4-8

# Optional: HTTP port (default 5273).
# PORT=5273
